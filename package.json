{
  "name": "k-bench",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
