{
  "name": "k-bench",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dev": "K_BENCH_INSTANCE=dev node --watch src/server/main.ts",
    "start": "node src/server/main.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
