{
  "name": "@k-electron/k-bench",
  "version": "0.0.0",
  "description": "Persistent terminal Sessions on your Mac, organised into Workspaces, reachable from any device on your tailnet.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-electron/k-bench.git"
  },
  "homepage": "https://github.com/k-electron/k-bench#readme",
  "bugs": {
    "url": "https://github.com/k-electron/k-bench/issues"
  },
  "keywords": [
    "claude-code",
    "tmux",
    "tailscale",
    "terminal",
    "macos"
  ],
  "os": [
    "darwin"
  ],
  "type": "module",
  "bin": {
    "k-bench": "dist/js/scripts/k-bench.js"
  },
  "files": [
    "dist/js",
    "dist/web",
    "scripts/fix-node-pty.mjs"
  ],
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:serve": "node scripts/dev-serve.ts",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "rm -rf dist/js && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "start": "node src/server/main.ts",
    "install-app": "node scripts/k-bench.ts install",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "smoke": "node scripts/smoke.ts",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "screenshots:record": "node scripts/record-hero.ts",
    "screenshots:scrub": "node scripts/scrub-recording.ts",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.16",
    "node-pty": "^1.1.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
